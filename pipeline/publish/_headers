# Cloudflare Pages headers for the threex-data site. The app runs on another origin.
/v1/manifest.json
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

/v1/tiles/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/v1/scoring/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/report/*
  Cache-Control: public, max-age=300
